[Desktop Entry]
Version=1.0
Type=Application
Name=Drosophila Genetics GUI (Linux)
Comment=Launch the Drosophila Genetics GUI
Exec=/bin/sh -lc 'REPO_DIR="$HOME/geneticsdrosophilaproject"; cd "$REPO_DIR/CodeDirectory" && ./launch_gui.sh'
Icon=/home/pi/geneticsdrosophilaproject/assets/drosophila.png
Terminal=false
Categories=Science;
