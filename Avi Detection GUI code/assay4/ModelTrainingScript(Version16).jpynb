        "## Section B — Global Settings & Modes\n",
        "\n",
        "This section holds the master configuration for our project. It defines where files are saved, how we split the data, and how hard we want to train the models. If you have an old model, you can use it as a benchmark for fine tuning, which can be easily done by changing the .pt file name. Currently the old notebook is called newone.pt.\n",
        "\n",
        "To make things easy, you can choose from four different **Execution Modes**:\n",
        "\n",
        "- **FAST**: A quick test run. Great for checking if the code works without waiting hours.\n",
        "- **STANDARD**: A practical, solid run that includes basic stress-testing and calibration.\n",
        "- **FULL**: Runs more models, tries more image variations, and gathers more diagnostics.\n",
        "- **MOONSHOT**: Throws everything at the wall—extra model architectures, heavy stress testing, and deep visual analysis."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "3c2c9bfb",
      "metadata": {
        "id": "3c2c9bfb"
      },
      "outputs": [],
      "source": [
        "# SECTION B — Dataclass config, path setup, and mode presets\n",
        "\n",
        "@dataclass\n",
        "class PathsConfig:\n",
        "    output_root: Path = Path(\"./fruitfly_transfer_outputs_v4\")\n",
        "    raw_download_root: Path = Path(\"./fruitfly_transfer_outputs_v4/00_roboflow_raw\")\n",
        "    audit_root: Path = Path(\"./fruitfly_transfer_outputs_v4/01_audit\")\n",
        "    manifest_root: Path = Path(\"./fruitfly_transfer_outputs_v4/02_manifests\")\n",
        "    split_root: Path = Path(\"./fruitfly_transfer_outputs_v4/03_splits\")\n",
        "    branch_root: Path = Path(\"./fruitfly_transfer_outputs_v4/04_branches\")\n",
        "    aug_cache_root: Path = Path(\"./fruitfly_transfer_outputs_v4/05_aug_cache\")\n",
        "    baseline_root: Path = Path(\"./fruitfly_transfer_outputs_v4/06_baselines\")\n",
        "    experiment_root: Path = Path(\"./fruitfly_transfer_outputs_v4/07_experiments\")\n",
        "    challenge_root: Path = Path(\"./fruitfly_transfer_outputs_v4/08_challenge_suites\")\n",
        "    analysis_root: Path = Path(\"./fruitfly_transfer_outputs_v4/09_analysis\")\n",
        "    final_root: Path = Path(\"./fruitfly_transfer_outputs_v4/10_final\")\n",
        "\n",
        "    def mkdirs(self) -> None:\n",
        "        for path in [\n",
        "            self.output_root,\n",
        "            self.raw_download_root,\n",
        "            self.audit_root,\n",
        "            self.manifest_root,\n",
        "            self.split_root,\n",
        "            self.branch_root,\n",
        "            self.aug_cache_root,\n",
        "            self.baseline_root,\n",
        "            self.experiment_root,\n",
        "            self.challenge_root,\n",
        "            self.analysis_root,\n",
        "            self.final_root,\n",
        "        ]:\n",
        "            path.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "@dataclass\n",
        "class NotebookConfig:\n",
        "    # ---- execution / compute mode ----\n",
        "    execution_mode: str = \"STANDARD\"  # FAST | STANDARD | FULL | MOONSHOT\n",
        "    run_name_tag: str = \"fruitfly_sexing_benchmark\"\n",
        "    random_seed: int = 1337\n",
        "    extra_seeds: List[int] = field(default_factory=lambda: [2027, 31415])\n",
        "    device: str = AUTO_DEVICE\n",
        "    num_workers: int = 0  # 0 is deliberate for Colab stability\n",
        "    use_amp: bool = True\n",
        "    deterministic: bool = True\n",
        "\n",
        "    # ---- Roboflow ----\n",
        "    roboflow_api_key: str = \"APIKEYGOESHERE\"\n",
        "    roboflow_workspace: str = \"fruit-fly-project\" #Update this with custom data set\n",
        "    roboflow_project: str = \"newflies\" #Update this with custom data set\n",
        "    roboflow_version: int = 1 #Update this with custom data set\n",
        "    roboflow_download_format: str = \"yolo26\" #Update this with custom data set\n",
        "\n",
        "    # ---- checkpoint discovery ----\n",
        "    old_model_path: Optional[Path] = None\n",
        "    old_model_search_order: List[str] = field(default_factory=lambda: [\n",
        "        \"./newone.pt\",\n",
        "        \"/content/newone.pt\",\n",
        "        \"/mnt/data/newone.pt\",\n",
        "    ])\n",
        "\n",
        "    # ---- labels ----\n",
        "    class_names: List[str] = field(default_factory=lambda: [\"female\", \"male\"])\n",
        "    label_id_to_name_override: Dict[int, str] = field(default_factory=lambda: {0: \"female\", 1: \"male\"})\n",
        "    expected_num_classes: int = 2\n",
        "\n",
        "    # ---- canonical split policy ----\n",
        "    train_fraction: float = 0.70\n",
        "    valid_fraction: float = 0.20\n",
        "    test_fraction: float = 0.10\n",
        "    prefer_raw_splits_when_trustworthy: bool = True\n",
        "    split_by_group_if_available: bool = True\n",
        "    stratify_split: bool = True\n",
        "    group_time_bucket_minutes: int = 30\n",
        "    min_images_per_class_per_split: int = 2\n",
        "    group_trial_count: int = 400\n",
        "    force_rebuild_splits: bool = False\n",
        "\n",
        "    # ---- duplicate / leakage audit ----\n",
        "    compute_dhash: bool = True\n",
        "    near_duplicate_hamming_threshold: int = 5\n",
        "    max_near_duplicate_pairs_to_save: int = 5000\n",
        "    remove_exact_duplicates_from_training_only: bool = False\n",
        "\n",
        "    # ---- branch building ----\n",
        "    branch_export_size: int = 640\n",
        "    branch_names_enabled: List[str] = field(default_factory=lambda: [\"RAW\", \"TIGHT_CROP\", \"BACKGROUND_REDUCED\", \"STANDARDIZED_FRAME\"])\n",
        "    tight_crop_margin: float = 0.15\n",
        "    background_margin: float = 0.20\n",
        "    standardized_frame_margin: float = 0.22\n",
        "    standardized_object_fraction: float = 0.72\n",
        "    background_fill_mode: str = \"median\"\n",
        "    force_rebuild_branches: bool = False\n",
        "\n",
        "    # ---- training transform / normalization ----\n",
        "    imagenet_mean: Tuple[float, float, float] = (0.485, 0.456, 0.406)\n",
        "    imagenet_std: Tuple[float, float, float] = (0.229, 0.224, 0.225)\n",
        "    image_size: int = 640\n",
        "    alt_image_size: int = 800\n",
        "    batch_size: int = 32\n",
        "    eval_batch_size: int = 32\n",
        "    epochs: int = 30\n",
        "    scratch_epochs: int = 40\n",
        "    patience: int = 8\n",
        "    lr: float = 1e-3\n",
        "    low_lr: float = 5e-4\n",
        "    weight_decay: float = 1e-4\n",
        "    strong_weight_decay: float = 5e-4\n",
        "    optimizer_name: str = \"AdamW\"\n",
        "    scheduler_name: str = \"cosine\"\n",
        "    label_smoothing: float = 0.0\n",
        "    stronger_label_smoothing: float = 0.05\n",
        "    dropout: float = 0.0\n",
        "    stronger_dropout: float = 0.10\n",
        "    freeze_backbone_epochs: int = 0\n",
        "    warmup_freeze_epochs: int = 3\n",
        "    max_grad_norm: Optional[float] = 5.0\n",
        "    early_stopping_metric: str = \"macro_f1\"\n",
        "    selection_primary_metric: str = \"macro_f1\"\n",
        "    use_class_weights_when_imbalanced: bool = True\n",
        "    imbalance_ratio_trigger: float = 1.4\n",
        "    weighted_sampler_in_advanced_mode: bool = True\n",
        "    use_focal_loss_in_moonshot: bool = True\n",
        "    focal_gamma: float = 1.5\n",
        "\n",
        "    # ---- augmentation profiles ----\n",
        "    use_offline_aug_cache: bool = True\n",
        "    force_regenerate_aug_cache: bool = False\n",
        "    max_offline_aug_copies_per_image: int = 1\n",
        "    run_online_aug_for_final_retrain: bool = True\n",
        "    background_robust_aug_enabled: bool = True\n",
        "\n",
        "    # ---- dataset branches and robustness ----\n",
        "    branch_comparison_top_k: int = 2\n",
        "    holdout_challenge_top_k: int = 2\n",
        "    valid_challenge_top_k: int = 5\n",
        "    challenge_suite_names: List[str] = field(default_factory=lambda: [\n",
        "        \"brightness_down\",\n",
        "        \"brightness_up\",\n",
        "        \"contrast_low\",\n",
        "        \"gaussian_blur\",\n",
        "        \"gaussian_noise\",\n",
        "        \"desaturate\",\n",
        "        \"jpeg_compression\",\n",
        "        \"crop_shift\",\n",
        "    ])\n",
        "    materialize_challenge_copies: bool = True\n",
        "    force_regenerate_challenge_copies: bool = False\n",
        "\n",
        "    # ---- evaluation / calibration ----\n",
        "    confidence_thresholds: List[float] = field(default_factory=lambda: [round(x, 2) for x in np.arange(0.30, 0.951, 0.05)])\n",
        "    ece_bins: int = 15\n",
        "    threshold_min_coverage: float = 0.80\n",
        "    run_temperature_scaling: bool = True\n",
        "    run_tta: bool = True\n",
        "    tta_top_k: int = 2\n",
        "    tta_views: Tuple[str, ...] = (\"identity\", \"hflip\", \"rot_pos\", \"rot_neg\")\n",
        "    run_ensemble: bool = True\n",
        "    ensemble_top_k: int = 3\n",
        "\n",
        "    # ---- advanced / moonshot ----\n",
        "    run_second_backbone_family: bool = False\n",
        "    second_backbone_name: str = \"efficientnet_b0\"\n",
        "    second_backbone_scratch_name: str = \"mobilenet_v3_small\"\n",
        "    run_embedding_analysis: bool = True\n",
        "    run_gradcam: bool = True\n",
        "    run_label_noise_audit: bool = True\n",
        "    run_nearest_neighbor_audit: bool = True\n",
        "    run_multi_seed_followup: bool = False\n",
        "    multi_seed_top_k: int = 3\n",
        "\n",
        "    # ---- final export ----\n",
        "    run_final_retrain: bool = False\n",
        "    final_retrain_seed: int = 4242\n",
        "    final_export_torchscript: bool = False\n",
        "\n",
        "    # ---- reporting ----\n",
        "    show_misclassified_examples: bool = True\n",
        "    num_misclassified_to_show: int = 24\n",
        "    narrative_materiality_delta: float = 0.02\n",
        "    paths: PathsConfig = field(default_factory=PathsConfig)\n",
        "\n",
        "def resolve_old_model_path(cfg: NotebookConfig) -> Optional[Path]:\n",
        "    candidates: List[Path] = []\n",
        "    if cfg.old_model_path is not None:\n",
        "        candidates.append(Path(cfg.old_model_path))\n",
        "    for raw in cfg.old_model_search_order:\n",
        "        candidates.append(Path(raw))\n",
        "    search_roots = [Path(\".\"), Path(\"/content\"), Path(\"/mnt/data\")]\n",
        "    for root in search_roots:\n",
        "        if root.exists():\n",
        "            candidates.extend(sorted(root.glob(\"*.pt\")))\n",
        "    seen = set()\n",
        "    deduped = []\n",
        "    for path in candidates:\n",
        "        path = Path(path)\n",
        "        if str(path) not in seen:\n",
        "            seen.add(str(path))\n",
        "            deduped.append(path)\n",
        "    for path in deduped:\n",
        "        if path.exists():\n",
        "            return path.resolve()\n",
        "    return None\n",
        "\n",
        "def apply_mode_preset(cfg: NotebookConfig) -> NotebookConfig:\n",
        "    mode = cfg.execution_mode.upper().strip()\n",
        "    cfg.execution_mode = mode\n",
        "\n",
        "    if mode == \"FAST\":\n",
        "        cfg.branch_names_enabled = [\"RAW\", \"TIGHT_CROP\"]\n",
        "        cfg.branch_comparison_top_k = 1\n",
        "        cfg.valid_challenge_top_k = 2\n",
        "        cfg.holdout_challenge_top_k = 1\n",
        "        cfg.run_second_backbone_family = False\n",
        "        cfg.run_embedding_analysis = False\n",
        "        cfg.run_gradcam = False\n",
        "        cfg.run_label_noise_audit = False\n",
        "        cfg.run_nearest_neighbor_audit = True\n",
        "        cfg.run_multi_seed_followup = False\n",
        "        cfg.run_final_retrain = False\n",
        "        cfg.run_tta = False\n",
        "        cfg.run_ensemble = False\n",
        "        cfg.challenge_suite_names = [\"brightness_down\", \"gaussian_blur\", \"crop_shift\"]\n",
        "    elif mode == \"STANDARD\":\n",
        "        cfg.branch_names_enabled = [\"RAW\", \"TIGHT_CROP\", \"BACKGROUND_REDUCED\", \"STANDARDIZED_FRAME\"]\n",
        "        cfg.branch_comparison_top_k = 2\n",
        "        cfg.valid_challenge_top_k = 5\n",
        "        cfg.holdout_challenge_top_k = 2\n",
        "        cfg.run_second_backbone_family = False\n",
        "        cfg.run_embedding_analysis = True\n",
        "        cfg.run_gradcam = True\n",
        "        cfg.run_label_noise_audit = True\n",
        "        cfg.run_nearest_neighbor_audit = True\n",
        "        cfg.run_multi_seed_followup = False\n",
        "        cfg.run_final_retrain = False\n",
        "        cfg.run_tta = True\n",
        "        cfg.run_ensemble = True\n",
        "    elif mode == \"FULL\":\n",
        "        cfg.branch_names_enabled = [\"RAW\", \"TIGHT_CROP\", \"BACKGROUND_REDUCED\", \"STANDARDIZED_FRAME\"]\n",
        "        cfg.branch_comparison_top_k = 3\n",
        "        cfg.valid_challenge_top_k = 8\n",
        "        cfg.holdout_challenge_top_k = 3\n",
        "        cfg.run_second_backbone_family = True\n",
        "        cfg.run_embedding_analysis = True\n",
        "        cfg.run_gradcam = True\n",
        "        cfg.run_label_noise_audit = True\n",
        "        cfg.run_nearest_neighbor_audit = True\n",
        "        cfg.run_multi_seed_followup = True\n",
        "        cfg.run_final_retrain = True\n",
        "        cfg.run_tta = True\n",
        "        cfg.run_ensemble = True\n",
        "    elif mode == \"MOONSHOT\":\n",
        "        cfg.branch_names_enabled = [\"RAW\", \"TIGHT_CROP\", \"BACKGROUND_REDUCED\", \"STANDARDIZED_FRAME\"]\n",
        "        cfg.branch_comparison_top_k = 3\n",
        "        cfg.valid_challenge_top_k = 10\n",
        "        cfg.holdout_challenge_top_k = 4\n",
        "        cfg.run_second_backbone_family = True\n",
        "        cfg.run_embedding_analysis = True\n",
        "        cfg.run_gradcam = True\n",
        "        cfg.run_label_noise_audit = True\n",
        "        cfg.run_nearest_neighbor_audit = True\n",
        "        cfg.run_multi_seed_followup = True\n",
        "        cfg.run_final_retrain = True\n",
        "        cfg.run_tta = True\n",
        "        cfg.run_ensemble = True\n",
        "        cfg.challenge_suite_names = [\n",
        "            \"brightness_down\",\n",
        "            \"brightness_up\",\n",
        "            \"contrast_low\",\n",
        "            \"gaussian_blur\",\n",
        "            \"gaussian_noise\",\n",
        "            \"desaturate\",\n",
        "            \"jpeg_compression\",\n",
        "            \"crop_shift\",\n",
        "            \"sharpness_down\",\n",
        "            \"grayscale_mix\",\n",
        "        ]\n",
        "    else:\n",
        "        raise ValueError(f\"Unknown execution_mode: {cfg.execution_mode}\")\n",
        "\n",
        "    cfg.paths.mkdirs()\n",
        "    cfg.old_model_path = resolve_old_model_path(cfg)\n",
        "    return cfg\n",
        "\n",
        "CFG = apply_mode_preset(NotebookConfig())\n",
        "seed_everything(CFG.random_seed, deterministic=CFG.deterministic)\n",
        "\n",
        "timestamp_tag = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "CFG.paths.experiment_root = CFG.paths.experiment_root / f\"{CFG.run_name_tag}_{CFG.execution_mode.lower()}_{timestamp_tag}\"\n",
        "CFG.paths.experiment_root.mkdir(parents=True, exist_ok=True)\n",
        "CFG.paths.final_root.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "config_json_path = CFG.paths.output_root / \"notebook_config.json\"\n",
        "with open(config_json_path, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(\n",
        "        {\n",
        "            k: (str(v) if isinstance(v, Path) else v)\n",
        "            for k, v in asdict(CFG).items()\n",
        "        },\n",
        "        f,\n",
        "        indent=2,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "print_rule(\"CONFIG SNAPSHOT\")\n",
        "print(\"EXECUTION_MODE:\", CFG.execution_mode)\n",
        "print(\"OUTPUT_ROOT:\", CFG.paths.output_root.resolve())\n",
        "print(\"EXPERIMENT_ROOT:\", CFG.paths.experiment_root.resolve())\n",
        "print(\"OLD_MODEL_PATH:\", CFG.old_model_path)\n",
        "print(\"CLASS_NAMES:\", CFG.class_names)\n",
        "print(\"BRANCHES_ENABLED:\", CFG.branch_names_enabled)\n",
        "print(\"CHALLENGE_SUITES:\", CFG.challenge_suite_names)\n",
        "print(\"Saved config to:\", config_json_path.resolve())\n"
      ]
