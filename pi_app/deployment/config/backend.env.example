# Raspberry Pi backend runtime configuration example
#
# Copy to pi_app/deployment/config/backend.env for a canonical Pi-local override,
# or keep using deployment/pi/config/backend.env for compatibility.

# Virtual environment path relative to the repository root.
DROSOPHILA_VENV_PATH=.venv

# Backend API authentication
DROSOPHILA_API_KEY=change-me

# GPIO / hardware backend
GPIOZERO_PIN_FACTORY=lgpio

# Uvicorn application settings
DROSOPHILA_BACKEND_APP=pi_backend.api.app:app
DROSOPHILA_BACKEND_HOST=0.0.0.0
DROSOPHILA_BACKEND_PORT=8000

# Set to 1 for development reload, 0 for normal backend execution.
DROSOPHILA_BACKEND_RELOAD=0

# If the service is intentionally stopped 3 times within this many seconds,
# automatic restart is suppressed until reboot or the window expires.
DROSOPHILA_STOP_RESET_WINDOW_SEC=300

