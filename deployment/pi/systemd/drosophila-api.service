[Unit]
Description=Drosophila Backend API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=team8
WorkingDirectory=/home/team8/geneticsdrosophilaproject
ExecStart=/home/team8/geneticsdrosophilaproject/start_backend.sh
Restart=always
RestartSec=3
Environment=HOME=/home/team8

[Install]
WantedBy=multi-user.target