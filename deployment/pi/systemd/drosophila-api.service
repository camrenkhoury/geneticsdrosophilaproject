[Unit]
Description=Drosophila Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=%h/geneticsdrosophilaproject
EnvironmentFile=-%h/geneticsdrosophilaproject/deployment/pi/config/backend.env
ExecStart=%h/geneticsdrosophilaproject/start_backend.sh
Restart=always
RestartSec=5
RestartPreventExitStatus=77

[Install]
WantedBy=multi-user.target
